#!/usr/bin/env bash

set -euo pipefail # exit at the first fail in short

repo="$(cd "$(dirname "$0")"&& pwd)"
backup="$HOME/.local/state/dotfiles/backup/$(date +%F_%H%M%S)"
opts=(-a --delete --itemize-changes --backup --backup-dir="$backup")
[[ "${1:-}" == "-n" ]] && opts+=(--dry-run)

declare -A map=(
    [hypr]="$HOME/.config/hypr"
    [nvim]="$HOME/.config/nvim"
    [fish]="$HOME/.config/fish"
    [kitty]="$HOME/.config/kitty"
    [matugen]="$HOME/.config/matugen"
    [git]="$HOME/.config/git"
    [lazygit]="$HOME/.config/lazygit"
)

for src in "${!map[@]}"; do
    rsync "${opts[@]}" \
        --filter='P fish_variables' \
        --exclude=lazy-lock.json \
        "$repo/$src/" "${map[$src]}/"
done

rsync -a --itemize-changes "${dry[@]}" "$repo/starship/starship.toml" "$HOME/.config/starship.toml"

